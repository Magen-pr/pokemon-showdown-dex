#!/usr/bin/env node

/**
 * Builds each game's data from the server, then writes index.html from
 * index.template.html, setting the version query string of each resource
 * to the MD5 hash of that resource.
 */

const fs = require('fs');
const path = require('path');
const crypto = require('crypto');
const child_process = require('child_process');
const Config = require('./config/config');

process.chdir(__dirname);

child_process.execSync('node build-tools/build-game-data', {stdio: 'inherit'});
child_process.execSync('node build-tools/build-usage-stats', {stdio: 'inherit'});

const clientDir = path.resolve(Config.clientDir || '../pokemon-showdown-client', 'play.pokemonshowdown.com');

function updateFiles() {
	let indexContents = fs.readFileSync('index.template.html', {encoding: 'utf8'});

	// add hashes to js and css files
	process.stdout.write("Updating hashes... ");
	indexContents = indexContents.replace(/(src|href)="\/(.*?)\?[a-z0-9]*?"/g, function (a, b, c) {
		let hash = Math.random().toString(36).slice(2, 10); // just in case creating the hash fails
		try {
			let filepath = c;
			if (c.startsWith('/play.pokemonshowdown.com/')) {
				filepath = path.join(clientDir, c.slice('/play.pokemonshowdown.com/'.length));
			}
			const fstr = fs.readFileSync(filepath, {encoding: 'utf8'});
			hash = crypto.createHash('md5').update(fstr).digest('hex').substr(0, 8);
		} catch (e) {}

		return b + '="/' + c + '?' + hash + '"';
	});
	indexContents = indexContents.replace(/(src|href)="(.*?)\/(.*?)[a-z0-9]*?"/g, (match) => replaceRoutes(match));
	indexContents = indexContents.replace('<!-- games -->', '<script>var GameList = ' + JSON.stringify(getGameList()) + ';</script>');
	console.log("DONE");

	process.stdout.write("Writing new `index.html` file... ");
	fs.writeFileSync('index.html', indexContents);
	console.log("DONE");
}

function fileHash(filepath) {
	try {
		return crypto.createHash('md5').update(fs.readFileSync(filepath)).digest('hex').substr(0, 8);
	} catch (e) {
		return null;
	}
}

function getGameList() {
	const gameList = JSON.parse(fs.readFileSync('games.json', 'utf8'));
	for (const gameid in gameList.games) {
		const game = gameList.games[gameid];
		game.files = [];
		for (const file of [`data/${gameid}.js`, `data/${gameid}-game.js`]) {
			const hash = fileHash(file);
			if (hash) game.files.push(`/${file}?${hash}`);
		}
	}
	return gameList;
}

function replaceRoutes(url) {
	return url.replace('/replay.pokemonshowdown.com/', '/' + Config.routes.replays + '/')
		.replace('/play.pokemonshowdown.com/', '/' + Config.routes.client + '/')
		.replace('/pokemonshowdown.com/', '/' + Config.routes.root + '/');
}

updateFiles();
